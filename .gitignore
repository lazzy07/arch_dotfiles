# OpenDeck plugin settings can contain OAuth tokens/secrets (e.g. Spotify).
# These are per-machine and regenerated by re-authenticating in the plugin's
# property inspector, so they're intentionally not tracked.
.config/opendeck/settings/

# Installed plugin binaries/deps (compiled code, node_modules) - reinstall
# these from the OpenDeck plugin store rather than vendoring them here.
.config/opendeck/plugins/
